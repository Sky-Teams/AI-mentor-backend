NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_mentor?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GROQ_API_KEY=gsk_your-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=45000
AI_REVIEW_TEMPERATURE=0.2
AI_PARAPHRASE_TEMPERATURE=0.4
APP_REVIEW_CREDIT_COST=25
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
SWAGGER_ENABLED=true
DEFAULT_ADMIN_EMAIL=admin@aimentor.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
FRONTEND_URL=http://localhost:5173
EMAIL_FROM=email-from
FRONTEND_URL=http://localhost:5173
BRAND_NAME=Ai Mentor
BREVO_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=brevo_api_key
SUBSCRIPTION_EXPIRE_SCHEDULE_TIME='* * * * *'
